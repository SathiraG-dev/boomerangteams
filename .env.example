# Copy to .env for local development. Railway injects DATABASE_URL and PORT
# automatically in production once the Postgres plugin is linked to this service.

# Postgres connection string (Railway Postgres plugin provides this)
DATABASE_URL=postgres://user:password@localhost:5432/boomerangteams

# Set to "require" only if your Postgres connection needs SSL (e.g. connecting
# to Railway's public proxy URL instead of the internal one).
# PGSSL=require

PORT=3000

# Admin panel (/admin) — single shared password, no per-user accounts.
# Pick long random values; both are required for /admin to work at all.
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-too-a-long-random-string
